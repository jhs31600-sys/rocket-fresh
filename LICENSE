'use strict';

const test = require('node:test');
const assert = require('node:assert/strict');
const { generateHmac, normalizeProducts, safeProductUrl } = require('../lib/coupang');

test('HMAC 헤더는 고정 시각에서 결정적으로 생성된다', () => {
  const header = generateHmac(
    'GET',
    '/v2/providers/test?keyword=%EB%8C%80%ED%8C%8C',
    'secret',
    'access',
    new Date('2026-07-25T12:34:56.000Z')
  );
  assert.match(header, /^CEA algorithm=HmacSHA256, access-key=access, signed-date=260725T123456Z, signature=[a-f0-9]{64}$/);
});

test('상품 응답은 필요한 공개 필드만 남긴다', () => {
  const products = normalizeProducts({
    data: {
      productData: [{
        productId: 1,
        productName: '테스트 두부',
        productPrice: 2100,
        productImage: 'https://image.example.com/a.jpg',
        productUrl: 'https://link.coupang.com/a/test',
        isRocket: true,
        isFreeShipping: false,
        privateField: 'remove-me'
      }]
    }
  });
  assert.equal(products.length, 1);
  assert.deepEqual(Object.keys(products[0]).sort(), [
    'categoryName', 'image', 'isFreeShipping', 'isRocket', 'name', 'price', 'productId', 'url'
  ].sort());
});

test('허용되지 않은 외부 상품 URL은 제거한다', () => {
  assert.equal(safeProductUrl('https://evil.example.com/item'), '');
  assert.match(safeProductUrl('https://www.coupang.com/vp/products/1'), /^https:\/\/www\.coupang\.com/);
});
