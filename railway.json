'use strict';

const test = require('node:test');
const assert = require('node:assert/strict');
const fs = require('node:fs');
const path = require('node:path');

const publicDir = path.resolve(__dirname, '..', 'public');

function existsFromPublic(urlPath) {
  return fs.existsSync(path.join(publicDir, String(urlPath).replace(/^\//, '')));
}

test('PWA 매니페스트의 아이콘 파일이 모두 존재한다', () => {
  const manifest = JSON.parse(fs.readFileSync(path.join(publicDir, 'manifest.webmanifest'), 'utf8'));
  assert.ok(Array.isArray(manifest.icons));
  for (const icon of manifest.icons) {
    assert.equal(existsFromPublic(icon.src), true, `${icon.src} 파일이 필요합니다.`);
  }
});

test('서비스 워커가 사전 캐시하는 정적 파일이 모두 존재한다', () => {
  const source = fs.readFileSync(path.join(publicDir, 'sw.js'), 'utf8');
  const block = source.match(/const STATIC_ASSETS = \[([\s\S]*?)\];/);
  assert.ok(block, 'STATIC_ASSETS 배열이 필요합니다.');
  const assets = [...block[1].matchAll(/'([^']+)'/g)].map(match => match[1]);
  for (const asset of assets) {
    if (asset === '/') continue;
    assert.equal(existsFromPublic(asset), true, `${asset} 파일이 필요합니다.`);
  }
});

test('핵심 공개 페이지가 존재한다', () => {
  for (const file of ['index.html', 'privacy.html', 'terms.html', '404.html']) {
    assert.equal(fs.existsSync(path.join(publicDir, file)), true, `${file} 파일이 필요합니다.`);
  }
});
