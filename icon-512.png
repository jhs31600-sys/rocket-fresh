'use strict';

const crypto = require('node:crypto');

const API_DOMAIN = 'https://api-gateway.coupang.com';
const ACCESS_KEY = () => String(process.env.COUPANG_ACCESS_KEY || '').trim();
const SECRET_KEY = () => String(process.env.COUPANG_SECRET_KEY || '').trim();
const SUB_ID = () => String(process.env.COUPANG_SUB_ID || 'freshfill').trim().slice(0, 50);

function isConfigured() {
  return Boolean(ACCESS_KEY() && SECRET_KEY());
}

function ensureConfigured() {
  if (isConfigured()) return;
  const error = new Error('쿠팡 API 키가 설정되지 않았습니다. 검색 링크 모드를 이용해주세요.');
  error.status = 503;
  throw error;
}

function generateHmac(method, pathWithQuery, secretKey, accessKey, now = new Date()) {
  const yymmdd = String(now.getUTCFullYear()).slice(2) + pad(now.getUTCMonth() + 1) + pad(now.getUTCDate());
  const hhmmss = pad(now.getUTCHours()) + pad(now.getUTCMinutes()) + pad(now.getUTCSeconds());
  const datetime = `${yymmdd}T${hhmmss}Z`;
  const questionMark = pathWithQuery.indexOf('?');
  const pathOnly = questionMark >= 0 ? pathWithQuery.slice(0, questionMark) : pathWithQuery;
  const query = questionMark >= 0 ? pathWithQuery.slice(questionMark + 1) : '';
  const message = datetime + String(method).toUpperCase() + pathOnly + query;
  const signature = crypto.createHmac('sha256', secretKey).update(message).digest('hex');
  return `CEA algorithm=HmacSHA256, access-key=${accessKey}, signed-date=${datetime}, signature=${signature}`;
}

async function searchProducts(keyword, options = {}) {
  ensureConfigured();
  const cleanKeyword = String(keyword || '').replace(/[\u0000-\u001f\u007f]/g, ' ').replace(/\s+/g, ' ').trim();
  if (!cleanKeyword || cleanKeyword.length > 80) {
    const error = new Error('검색어는 1자 이상 80자 이하로 입력해주세요.');
    error.status = 400;
    throw error;
  }

  const apiLimit = Math.max(1, Math.min(10, Math.round(Number(options.apiLimit || 10))));
  const query = new URLSearchParams({
    keyword: cleanKeyword,
    limit: String(apiLimit),
    subId: SUB_ID()
  });
  const pathWithQuery = `/v2/providers/affiliate_open_api/apis/openapi/products/search?${query.toString()}`;
  const data = await coupangRequest('GET', pathWithQuery);
  return normalizeProducts(data);
}

async function createDeepLinks(urls) {
  ensureConfigured();
  const coupangUrls = (Array.isArray(urls) ? urls : [])
    .map(value => String(value || '').trim())
    .filter(isCoupangDestination)
    .slice(0, 10);

  if (!coupangUrls.length) {
    const error = new Error('유효한 쿠팡 URL이 필요합니다.');
    error.status = 400;
    throw error;
  }

  const pathOnly = '/v2/providers/affiliate_open_api/apis/openapi/v1/deeplink';
  return coupangRequest('POST', pathOnly, { coupangUrls });
}

async function coupangRequest(method, pathWithQuery, body) {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 8_000);

  try {
    const authorization = generateHmac(method, pathWithQuery, SECRET_KEY(), ACCESS_KEY());
    const response = await fetch(`${API_DOMAIN}${pathWithQuery}`, {
      method,
      headers: {
        Authorization: authorization,
        'Content-Type': 'application/json;charset=UTF-8',
        Accept: 'application/json'
      },
      body: body ? JSON.stringify(body) : undefined,
      signal: controller.signal
    });

    const text = await response.text();
    let data;
    try {
      data = text ? JSON.parse(text) : {};
    } catch (_) {
      data = { raw: text };
    }

    if (!response.ok || (data.rCode && String(data.rCode) !== '0')) {
      const error = new Error(data.message || data.rMessage || `쿠팡 API 오류 (${response.status})`);
      error.status = response.status >= 400 ? response.status : 502;
      throw error;
    }
    return data;
  } catch (error) {
    if (error && error.name === 'AbortError') {
      const timeoutError = new Error('쿠팡 API 응답 시간이 초과됐습니다.');
      timeoutError.status = 504;
      throw timeoutError;
    }
    throw error;
  } finally {
    clearTimeout(timeout);
  }
}

function normalizeProducts(data) {
  const list = data?.data?.productData || data?.productData || [];
  if (!Array.isArray(list)) return [];

  return list
    .map(item => ({
      productId: String(item.productId || ''),
      name: String(item.productName || '').trim(),
      price: Math.max(0, Math.round(Number(item.productPrice || 0))),
      image: safeHttpsUrl(item.productImage),
      url: safeProductUrl(item.productUrl),
      categoryName: String(item.categoryName || '').trim(),
      isRocket: Boolean(item.isRocket),
      isFreeShipping: Boolean(item.isFreeShipping)
    }))
    .filter(product => product.name && product.price > 0 && product.url);
}

function safeHttpsUrl(value) {
  try {
    const url = new URL(String(value || ''));
    return url.protocol === 'https:' ? url.toString() : '';
  } catch (_) {
    return '';
  }
}

function safeProductUrl(value) {
  try {
    const url = new URL(String(value || ''));
    const host = url.hostname.toLowerCase();
    const allowed = host === 'coupang.com' || host.endsWith('.coupang.com') || host === 'coupa.ng';
    return url.protocol === 'https:' && allowed ? url.toString() : '';
  } catch (_) {
    return '';
  }
}

function isCoupangDestination(value) {
  return Boolean(safeProductUrl(value));
}

function pad(value) {
  return String(value).padStart(2, '0');
}

module.exports = {
  isConfigured,
  ensureConfigured,
  generateHmac,
  searchProducts,
  createDeepLinks,
  normalizeProducts,
  safeProductUrl
};
