'use strict';

const test = require('node:test');
const assert = require('node:assert/strict');
const R = require('../public/recommender.js');

const sample = [
  { name: '서울우유', price: 5000, qty: 1 },
  { name: '무항생제 계란', price: 8000, qty: 1 }
];

test('13,000원 장바구니는 2,000원이 부족하다', () => {
  const result = R.recommend(sample, { minAmount: 15000, limit: 5 });
  assert.equal(result.total, 13000);
  assert.equal(result.required, 2000);
  assert.equal(result.isReady, false);
  assert.equal(result.recommendations.length, 5);
});

test('장바구니에 이미 있는 계란은 기본 추천에서 제외한다', () => {
  const result = R.recommend(sample, { minAmount: 15000, limit: 20 });
  assert.equal(result.recommendations.some(item => item.id === 'egg-small-pack'), false);
});

test('금액 문자열을 원 단위 정수로 파싱한다', () => {
  assert.equal(R.parsePrice('12,345원'), 12345);
  assert.equal(R.parsePrice(' 8 000 '), 8000);
});

test('쿠팡 검색 URL은 검색어를 안전하게 인코딩한다', () => {
  const url = R.createSearchUrl('로켓프레시 대파');
  assert.match(url, /^https:\/\/www\.coupang\.com\/np\/search\?/);
  assert.match(url, /%EB%A1%9C%EC%BC%93%ED%94%84%EB%A0%88%EC%8B%9C/);
});
